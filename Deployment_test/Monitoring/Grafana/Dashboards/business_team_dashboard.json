{
  "uid": "binance-business-dashboard",
  "title": "Business Dashboard",
  "tags": ["binance", "business", "predictions", "ml"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Predictions",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(prediction_results_total{job=\"binance-api\"}) or vector(0)",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Bull Predictions",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "sum(prediction_results_total{job=\"binance-api\",direction=\"Bull\"}) or vector(0)",
          "legendFormat": "Bull",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Neutral Predictions",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(prediction_results_total{job=\"binance-api\",direction=\"Neutral\"}) or vector(0)",
          "legendFormat": "Neutral",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Bear Predictions",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "sum(prediction_results_total{job=\"binance-api\",direction=\"Bear\"}) or vector(0)",
          "legendFormat": "Bear",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Prediction Distribution",
      "type": "piechart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 5},
      "targets": [
        {
          "expr": "sum by (direction) (prediction_results_total{job=\"binance-api\"})",
          "legendFormat": "{{direction}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"min": 0},
        "overrides": []
      },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "reduceOptions": {"calcs": ["lastNotNull"], "values": true},
        "legend": {"displayMode": "list", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "single"}
      }
    },
    {
      "id": 6,
      "title": "Predictions Over Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 16, "x": 8, "y": 5},
      "targets": [
        {
          "expr": "sum by (direction) (increase(prediction_results_total{job=\"binance-api\"}[5m]))",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 7,
      "title": "Prediction Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {
          "expr": "sum(rate(prediction_results_total{job=\"binance-api\"}[5m]))",
          "legendFormat": "Predictions/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      }
    },
    {
      "id": 8,
      "title": "Prediction Latency - p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prediction_duration_seconds_bucket{job=\"binance-api\"}[5m])))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      }
    },
    {
      "id": 9,
      "title": "Production Model Information",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 22},
      "targets": [
        {
          "expr": "model_info{job=\"binance-api\"}",
          "legendFormat": "{{model_name}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {"show": false}
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": []
}
